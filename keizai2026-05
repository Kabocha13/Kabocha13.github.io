    "explanation": "公共財は多くの人に便益を与えるが、対価を徴収しにくく過少供給になりやすい。",
    "source": "総合復習",
    "id": 172
  },
  {
    "topic": "総合：労働",
    "question": "労働市場を需要供給で見るとき、通常の財市場と異なる対応として正しいものはどれか。",
    "choices": [
      "企業が需要側、労働者が供給側になる",
      "労働者が需要側、企業が供給側になる",
      "需要も供給も政府だけが担う",
      "価格にあたるものは存在しない"
    ],
    "answer": 0,
    "explanation": "労働サービスを買うのは企業、売るのは労働者。価格に相当するのが賃金。",
    "source": "総合復習",
    "id": 173
  },
  {
    "topic": "総合：取引費用",
    "question": "取引費用の存在が外部性問題につながる説明として正しいものはどれか。",
    "choices": [
      "被害者と加害者が交渉する市場を作る費用が高いと、外部費用が取引に反映されない",
      "取引費用が高いほど完全競争が必ず成立する",
      "取引費用が高いほど情報が完全になる",
      "取引費用は外部性と無関係"
    ],
    "answer": 0,
    "explanation": "外部性は、影響を受ける財・サービスの市場が成立しにくいことと関係する。",
    "source": "総合復習",
    "id": 174
  }
];

const $ = (id) => document.getElementById(id);
const topicSelect = $('topicSelect');
const orderSelect = $('orderSelect');
const limitInput = $('limitInput');
const quizView = $('quizView');
const resultView = $('resultView');
let session = [];
let current = 0;
let answered = false;
let score = 0;
let answers = [];
const storeKey = 'econQuizWrongIds_v1';

function getWrongSet() {
  try { return new Set(JSON.parse(localStorage.getItem(storeKey) || '[]')); }
  catch(e) { return new Set(); }
}
function saveWrongSet(set) { localStorage.setItem(storeKey, JSON.stringify([...set])); }
function shuffle(arr) {
  const a = [...arr];
  for (let i=a.length-1; i>0; i--) { const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; }
  return a;
}
function initTopics() {
  const topics = ['全範囲', ...new Set(QUESTIONS.map(q => q.topic))];
  topicSelect.innerHTML = topics.map(t => `<option value="${t}">${t}</option>`).join('');
  $('totalCount').textContent = QUESTIONS.length;
  updateStats();
}
function startQuiz() {
  const topic = topicSelect.value;
  let pool = topic === '全範囲' ? [...QUESTIONS] : QUESTIONS.filter(q => q.topic === topic);
  const wrongSet = getWrongSet();
  if (orderSelect.value === 'wrong') pool = pool.filter(q => wrongSet.has(q.id));
  if (orderSelect.value === 'shuffle' || orderSelect.value === 'wrong') pool = shuffle(pool);
  const limit = Math.max(1, Math.min(parseInt(limitInput.value || '20', 10), pool.length));
  session = pool.slice(0, limit);
  current = 0; answered = false; score = 0; answers = [];
  resultView.classList.add('hidden');
  quizView.classList.remove('hidden');
  if (!session.length) {
    quizView.innerHTML = `<h2>出題できる問題がありません</h2><p class="small">「苦手だけ」に問題がない場合は、通常順かランダムで開始してください。</p>`;
    updateStats();
    return;
  }
  renderQuestion();
}
function renderQuestion() {
  const q = session[current];
  answered = false;
  const choices = q.choices.map((c, i) => `<button class="choice" data-index="${i}">${escapeHtml(c)}</button>`).join('');
  quizView.innerHTML = `
    <div class="q-head">
      <div>
        <span class="pill">${escapeHtml(q.topic)}</span>
        <span class="pill">${escapeHtml(q.source || '授業資料')}</span>
      </div>
      <div class="q-num">${current + 1} / ${session.length}</div>
    </div>
    <div class="question">${escapeHtml(q.question)}</div>
    <div class="choices">${choices}</div>
    <div id="feedback" class="feedback"></div>
    <div class="nav">
      <button class="btn-ghost" id="prevBtn" ${current===0?'disabled':''}>前へ</button>
      <button class="btn-secondary" id="showListBtn">問題一覧</button>
      <button class="btn-primary" id="nextBtn" disabled>次へ</button>
    </div>
    <div id="listBox" class="list hidden"></div>
  `;
  document.querySelectorAll('.choice').forEach(btn => btn.addEventListener('click', () => choose(parseInt(btn.dataset.index,10))));
  $('prevBtn').addEventListener('click', () => { if (current > 0) { current--; renderQuestion(); } });
  $('nextBtn').addEventListener('click', () => { current < session.length - 1 ? (current++, renderQuestion()) : finishQuiz(); });
  $('showListBtn').addEventListener('click', toggleList);
  updateStats();
}
function choose(index) {
  if (answered) return;
  answered = true;
  const q = session[current];
  const correct = index === q.answer;
  if (correct) score++;
  answers[current] = { id:q.id, selected:index, correct };
  const wrongSet = getWrongSet();
  if (correct) wrongSet.delete(q.id); else wrongSet.add(q.id);
  saveWrongSet(wrongSet);
  document.querySelectorAll('.choice').forEach((btn, i) => {
    btn.disabled = true;
    if (i === q.answer) btn.classList.add('correct');
    if (i === index && !correct) btn.classList.add('wrong');
    if (i === index) btn.classList.add('selected');
  });
  const fb = $('feedback');
  fb.className = 'feedback ' + (correct ? 'good' : 'bad');
  fb.innerHTML = `<h3>${correct ? '正解' : '不正解'}</h3>
    <p><b>正答：</b>${escapeHtml(q.choices[q.answer])}</p>
    <p><b>解説：</b>${escapeHtml(q.explanation)}</p>`;
  $('nextBtn').disabled = false;
  updateStats();
}
function toggleList() {
  const box = $('listBox');
  box.classList.toggle('hidden');
  if (!box.classList.contains('hidden')) {
    box.innerHTML = session.map((q, i) => `<button data-jump="${i}">${i+1}. ${escapeHtml(q.question.slice(0,55))}${q.question.length>55?'…':''}</button>`).join('');
    box.querySelectorAll('button').forEach(b => b.addEventListener('click', () => { current = parseInt(b.dataset.jump,10); renderQuestion(); }));
  }
}
function finishQuiz() {
  const rate = session.length ? Math.round(score/session.length*100) : 0;
  quizView.classList.add('hidden');
  resultView.classList.remove('hidden');
  const rows = session.map((q, i) => {
    const a = answers[i];
    const mark = a?.correct ? '○' : '×';
    const selected = a ? q.choices[a.selected] : '未回答';
    return `<tr><td>${i+1}</td><td>${escapeHtml(q.topic)}</td><td>${escapeHtml(q.question)}</td><td>${mark}</td><td>${escapeHtml(selected)}</td><td>${escapeHtml(q.choices[q.answer])}</td></tr>`;
  }).join('');
  resultView.innerHTML = `
    <h2>結果：${score} / ${session.length}（${rate}%）</h2>
    <p class="small">間違えた問題は「苦手だけ」モードで復習できます。</p>
    <div class="row">
      <button class="btn-primary" onclick="startQuiz()">同じ条件でもう一度</button>
      <button class="btn-secondary" onclick="orderSelect.value='wrong'; startQuiz()">苦手だけ復習</button>
    </div>
    <table class="review-table"><thead><tr><th>#</th><th>分野</th><th>問題</th><th>判定</th><th>あなたの回答</th><th>正答</th></tr></thead><tbody>${rows}</tbody></table>
  `;
  updateStats();
}
function updateStats() {
  const done = answers.filter(Boolean).length;
  const rate = done ? Math.round(score/done*100) : 0;
  $('scoreStat').textContent = rate + '%';
  $('doneStat').textContent = done;
  $('wrongStat').textContent = getWrongSet().size;
  const progress = session.length ? Math.round(done/session.length*100) : 0;
  $('progressBar').style.width = progress + '%';
}
function escapeHtml(str) {
  return String(str).replace(/[&<>"']/g, s => {
    const map = {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}; return map[s];
  });
}
$('startBtn').addEventListener('click', startQuiz);
$('resetBtn').addEventListener('click', () => { if(confirm('苦手記録をリセットしますか？')) { localStorage.removeItem(storeKey); updateStats(); } });
initTopics();
startQuiz();
</script>
